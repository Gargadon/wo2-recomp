+REXCVAR_DECLARE(bool, wo2_queue_latency_trace);
+namespace {
+struct Wo2SubmissionTimer {
+  bool enabled;
+  std::chrono::steady_clock::time_point last;
+  Wo2SubmissionTimer() : enabled(REXCVAR_GET(wo2_queue_latency_trace)) {
+    if (enabled) last = std::chrono::steady_clock::now();
+  }
+  void Mark(unsigned phase) {
+    if (!enabled) return;
+    const auto now = std::chrono::steady_clock::now();
+    const auto us = std::chrono::duration_cast<std::chrono::microseconds>(now-last).count();
+    last = now;
+    using Callback = void (*)(unsigned, unsigned, unsigned);
+    static auto callback = reinterpret_cast<Callback>(
+        GetProcAddress(GetModuleHandleW(nullptr), "wo2_trace_queue_latency"));
+    if (callback && us >= 100) callback(24, phase, unsigned(std::min<int64_t>(us, UINT32_MAX)));
+  }
+};
+}
 
