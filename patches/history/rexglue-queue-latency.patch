+REXCVAR_DEFINE_BOOL(wo2_queue_latency_trace, false, "GPU", "Trace WO2 submissions and slow type-3 packets (restart required)");
+namespace {
+void Wo2TraceLatency(uint32_t kind, uint32_t detail, uint32_t value) {
+#if defined(_WIN32)
+  using Callback = void (*)(unsigned, unsigned, unsigned);
+  static auto callback = reinterpret_cast<Callback>(
+      GetProcAddress(GetModuleHandleW(nullptr), "wo2_trace_queue_latency"));
+  if (callback) callback(kind, detail, value);
+#endif
+}
+bool Wo2LatencyEnabled() {
+  static const bool enabled = REXCVAR_GET(wo2_queue_latency_trace);
+  return enabled;
+}
+struct Wo2PacketTimer {
+  uint32_t packet;
+  bool enabled;
+  std::chrono::steady_clock::time_point start;
+  explicit Wo2PacketTimer(uint32_t header)
+      : packet(header), enabled((header >> 30) == 3 && Wo2LatencyEnabled()) {
+    if (enabled) start = std::chrono::steady_clock::now();
+  }
+  ~Wo2PacketTimer() {
+    if (!enabled) return;
+    const auto us = std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now() - start).count();
+    if (us >= 1000) Wo2TraceLatency(21, packet, uint32_t(std::min<int64_t>(us, UINT32_MAX)));
+  }
+};
+}
