+void XEvent::SetGuestSignalState(bool signaled) {
+  const uint32_t guest_ptr = guest_object();
+  if (!guest_ptr) {
+    // Object never exposed to the guest (host-only event).
+    return;
+  }
+  auto* header = memory()->TranslateVirtual<X_DISPATCH_HEADER*>(guest_ptr);
+  header->signal_state = signaled ? 1u : 0u;
+}
+
+void XEvent::WaitCallback() {
+  // A wait on an auto-reset event clears it; a manual-reset event stays set.
+  if (!manual_reset_) {
+    SetGuestSignalState(false);
+  }
+}
+
 int32_t XEvent::Set(uint32_t priority_increment, bool wait) {
   event_->Set();
+  SetGuestSignalState(true);
   return 1;
 }
 
 int32_t XEvent::Pulse(uint32_t priority_increment, bool wait) {
   event_->Pulse();
+  // Best effort: the guest observes it as set, and a following wait clears it.
+  SetGuestSignalState(true);
+  if (!manual_reset_) {
+    SetGuestSignalState(false);
+  }
   return 1;
 }
 
 int32_t XEvent::Reset() {
   event_->Reset();
+  SetGuestSignalState(false);
   return 1;
 }
 
 void XEvent::Clear() {
   event_->Reset();
+  SetGuestSignalState(false);
 }
 
