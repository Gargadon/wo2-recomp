+void XEvent::SetGuestSignalState(bool signaled) {
+  const uint32_t guest_ptr = guest_object();
+  if (!guest_ptr) {
+    // Object never exposed to the guest (host-only event).
+    return;
+  }
+  auto* header = memory()->TranslateVirtual<X_DISPATCH_HEADER*>(guest_ptr);
+  header->signal_state = signaled ? 1u : 0u;
+}
+
+void XEvent::WaitCallback() {
+  if (!manual_reset_) {
+    std::lock_guard<std::mutex> lock(state_lock_);
+    host_signaled_ = false;
+    SetGuestSignalState(false);
+  }
+}
+
+void XEvent::SyncFromGuest() {
+  if (!guest_object()) return;
+  std::lock_guard<std::mutex> lock(state_lock_);
+  const bool signaled = guest_object<X_KEVENT>()->header.signal_state != 0;
+  if (signaled == host_signaled_) return;
+  host_signaled_ = signaled;
+  if (signaled) event_->Set();
+  else event_->Reset();
+}
+
 int32_t XEvent::Set(uint32_t priority_increment, bool wait) {
+  std::lock_guard<std::mutex> lock(state_lock_);
+  const int32_t previous = host_signaled_ ? 1 : 0;
+  SetGuestSignalState(true);
+  host_signaled_ = true;
   event_->Set();
-  return 1;
+  return previous;
 }
 
 int32_t XEvent::Pulse(uint32_t priority_increment, bool wait) {
+  std::lock_guard<std::mutex> lock(state_lock_);
+  const int32_t previous = host_signaled_ ? 1 : 0;
   event_->Pulse();
-  return 1;
+  host_signaled_ = false;
+  SetGuestSignalState(false);
+  return previous;
 }
 
 int32_t XEvent::Reset() {
+  std::lock_guard<std::mutex> lock(state_lock_);
+  const int32_t previous = host_signaled_ ? 1 : 0;
   event_->Reset();
-  return 1;
+  host_signaled_ = false;
+  SetGuestSignalState(false);
+  return previous;
 }
 
