+//
+// WO2 diagnostic (patch: wo2-draw-gpu-timings)
+// Per-draw GPU timestamps, to tell a uniform per-draw cost from a few heavy
+// draws. Enabled by default while the patch is applied; disable by setting
+// wo2_draw_gpu_timings to false. Output: "[wo2-draw]" lines in the GPU log.
+//
+extern uint64_t wo2_draw_ps_hashes[];
+extern uint32_t wo2_draw_ps_hash_count;
+extern uint32_t wo2_draw_ps_texmasks[];
+
+REXCVAR_DEFINE_BOOL(wo2_draw_gpu_timings, true, "GPU/D3D12",
+                    "Log per-draw GPU timings (WO2 diagnostic)");
+
+namespace {
+
+class Wo2DrawTimer {
+ public:
+  static constexpr uint32_t kMaxDraws = 4096;
+  static constexpr uint32_t kSlots = 2;
+  static constexpr uint32_t kBuckets = 6;
+
+  ID3D12QueryHeap* heap = nullptr;
+  ID3D12Resource* readback = nullptr;
+  ID3D12Fence* fence = nullptr;
+  uint64_t freq = 0;
+  uint64_t signal_value = 0;
+  uint32_t slot = 0;
+  uint32_t draw_count = 0;
+  uint64_t pending_value[kSlots] = {};
+  bool pending_valid[kSlots] = {};
+  double sum_us = 0.0;
+  double max_us = 0.0;
+  uint64_t measured = 0;
+  uint64_t buckets[kBuckets] = {};
+  uint32_t draw_kind[kSlots][kMaxDraws] = {};
+  uint32_t draw_size[kSlots][kMaxDraws] = {};
+  uint64_t draw_ps_hash[kSlots][kMaxDraws] = {};
+  uint32_t draw_ps_texmask[kSlots][kMaxDraws] = {};
+  uint32_t heavy_logged = 0;
+  uint32_t frames = 0;
+
+  void Ensure(ID3D12Device* device, ID3D12CommandQueue* queue) {
+    if (heap) return;
+    uint64_t f = 0;
+    if (FAILED(queue->GetTimestampFrequency(&f)) || !f) return;
+    freq = f;
+    D3D12_QUERY_HEAP_DESC query_desc = {};
+    query_desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    query_desc.Count = kMaxDraws * kSlots * 2;
+    if (FAILED(device->CreateQueryHeap(&query_desc, IID_PPV_ARGS(&heap)))) return;
+    D3D12_RESOURCE_DESC buffer_desc = {};
+    buffer_desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    buffer_desc.Width = uint64_t(kMaxDraws) * kSlots * 16;
+    buffer_desc.Height = 1;
+    buffer_desc.DepthOrArraySize = 1;
+    buffer_desc.MipLevels = 1;
+    buffer_desc.SampleDesc = {1, 0};
+    buffer_desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    D3D12_HEAP_PROPERTIES heap_props = {};
+    heap_props.Type = D3D12_HEAP_TYPE_READBACK;
+    if (FAILED(device->CreateCommittedResource(&heap_props, D3D12_HEAP_FLAG_NONE, &buffer_desc,
+                                               D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                               IID_PPV_ARGS(&readback)))) {
+      return;
+    }
+    if (FAILED(device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&fence)))) return;
+    REXGPU_INFO("[wo2-draw] per-draw GPU timings enabled, timestamp frequency {}", freq);
+  }
+
+  void BeginFrame() {
+    draw_count = 0;
+  }
+
+  void DrawBegin(ID3D12GraphicsCommandList* command_list, uint32_t kind, uint32_t count) {
+    if (!heap || draw_count >= kMaxDraws) return;
+    draw_kind[slot][draw_count] = kind;
+    draw_size[slot][draw_count] = count;
+    // Pixel shader hash recorded by the command processor for this draw.
+    draw_ps_hash[slot][draw_count] =
+        wo2_draw_ps_hashes[draw_count < wo2_draw_ps_hash_count ? draw_count : 0];
+    draw_ps_texmask[slot][draw_count] =
+        wo2_draw_ps_texmasks[draw_count < wo2_draw_ps_hash_count ? draw_count : 0];
+    command_list->EndQuery(heap, D3D12_QUERY_TYPE_TIMESTAMP,
+                           slot * (kMaxDraws * 2) + draw_count * 2);
+  }
+
+  void DrawEnd(ID3D12GraphicsCommandList* command_list) {
+    if (!heap || draw_count >= kMaxDraws) return;
+    command_list->EndQuery(heap, D3D12_QUERY_TYPE_TIMESTAMP,
+                           slot * (kMaxDraws * 2) + draw_count * 2 + 1);
+    ++draw_count;
+  }
+
+  void EndFrame(ID3D12GraphicsCommandList* command_list) {
+    if (!heap || !draw_count) return;
+    command_list->ResolveQueryData(heap, D3D12_QUERY_TYPE_TIMESTAMP, slot * (kMaxDraws * 2),
+                                   draw_count * 2, readback,
+                                   uint64_t(slot) * kMaxDraws * 16);
+  }
+
+  void SignalAndPoll(ID3D12CommandQueue* queue) {
+    if (!heap) return;
+    queue->Signal(fence, ++signal_value);
+    pending_value[slot] = signal_value;
+    pending_valid[slot] = true;
+    const uint64_t completed = fence->GetCompletedValue();
+    for (uint32_t i = 0; i < kSlots; ++i) {
+      if (!pending_valid[i] || pending_value[i] > completed) continue;
+      pending_valid[i] = false;
+      void* mapped = nullptr;
+      const size_t begin = size_t(i) * kMaxDraws * 16;
+      D3D12_RANGE range = {begin, begin + size_t(kMaxDraws) * 16};
+      if (FAILED(readback->Map(0, &range, &mapped))) continue;
+      const auto* stamps =
+          reinterpret_cast<const uint64_t*>(static_cast<const uint8_t*>(mapped) + begin);
+      for (uint32_t d = 0; d < kMaxDraws; ++d) {
+        const uint64_t t0 = stamps[d * 2];
+        const uint64_t t1 = stamps[d * 2 + 1];
+        if (!t1 || t1 <= t0) continue;
+        const double us = double(t1 - t0) * 1e6 / double(freq);
+        sum_us += us;
+        if (us > max_us) max_us = us;
+        ++measured;
+        if (us < 5.0) ++buckets[0];
+        else if (us < 15.0) ++buckets[1];
+        else if (us < 30.0) ++buckets[2];
+        else if (us < 60.0) ++buckets[3];
+        else if (us < 120.0) ++buckets[4];
+        else ++buckets[5];
+        // Log a sample of the heavy draws: kind 0 = indexed, 1 = instanced,
+        // size = index or vertex count, ps = pixel shader ucode hash.
+        if (us >= 500.0 && heavy_logged < 12) {
+          ++heavy_logged;
+          REXGPU_INFO("[wo2-heavy] kind={} size={} us={:.1f} ps={:016X} textures={:08X}",
+                      draw_kind[i][d], draw_size[i][d], us, draw_ps_hash[i][d],
+                      draw_ps_texmask[i][d]);
+        }
+      }
+      readback->Unmap(0, nullptr);
+      ++frames;
+    }
+    slot = (slot + 1) % kSlots;
+    if (frames >= 60) {
+      REXGPU_INFO(
+          "[wo2-draw] draws={} avg_us={:.1f} max_us={:.1f} buckets(<5,<15,<30,<60,<120,>120)="
+          "{},{},{},{},{},{}",
+          measured, measured ? sum_us / double(measured) : 0.0, max_us, buckets[0], buckets[1],
+          buckets[2], buckets[3], buckets[4], buckets[5]);
+      sum_us = 0.0;
+      max_us = 0.0;
+      measured = 0;
+      for (uint32_t b = 0; b < kBuckets; ++b) buckets[b] = 0;
+      frames = 0;
+    }
+  }
+};
+
+Wo2DrawTimer wo2_draw_timer;
+
+}  // namespace
+
+void Wo2DrawTimerEnsure(ID3D12Device* device, ID3D12CommandQueue* queue) {
+  if (!REXCVAR_GET(wo2_draw_gpu_timings)) return;
+  wo2_draw_timer.Ensure(device, queue);
+}
+void Wo2DrawTimerBegin() {
+  if (!REXCVAR_GET(wo2_draw_gpu_timings)) return;
+  wo2_draw_timer.BeginFrame();
+}
+void Wo2DrawTimerDrawBegin(ID3D12GraphicsCommandList* command_list, uint32_t kind,
+                           uint32_t count) {
+  if (!REXCVAR_GET(wo2_draw_gpu_timings)) return;
+  wo2_draw_timer.DrawBegin(command_list, kind, count);
+}
+void Wo2DrawTimerDrawEnd(ID3D12GraphicsCommandList* command_list) {
+  if (!REXCVAR_GET(wo2_draw_gpu_timings)) return;
+  wo2_draw_timer.DrawEnd(command_list);
+}
+void Wo2DrawTimerEnd(ID3D12GraphicsCommandList* command_list) {
+  if (!REXCVAR_GET(wo2_draw_gpu_timings)) return;
+  wo2_draw_timer.EndFrame(command_list);
+}
+void Wo2DrawTimerSignal(ID3D12CommandQueue* queue) {
+  if (!REXCVAR_GET(wo2_draw_gpu_timings)) return;
+  wo2_draw_timer.SignalAndPoll(queue);
+}
